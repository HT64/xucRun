# Purpose: Defines text normalization and binary handling for repository files.
# Approach: Assigns text normalization, platform line endings, and binary handling with path patterns.
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.cpp text eol=crlf
*.h text eol=crlf
*.inl text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
*.rcinc text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

*.json text eol=lf
*.md text eol=lf

*.ico binary
