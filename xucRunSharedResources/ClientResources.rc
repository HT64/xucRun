	IDS_COMMAND_LAUNCH_FAILED, "Der Befehl {0} konnte nicht gestartet werden."
	IDS_LANGUAGE_CHANGE_FAILED, "Die UI-Sprache konnte nicht geändert werden.\n\n{0}"
	IDS_CAUSE_UNKNOWN, "Die Ursache konnte nicht ermittelt werden."
	IDS_ERROR_CODE, "Fehlercode: {0}"
	IDS_BROKER_START_FAILED, "Der Dienst konnte nicht gestartet werden.\n\n{0}"
	IDS_PURGE_ELEVATION_UNKNOWN, "Der Elevationsstatus konnte nicht sicher ermittelt werden. Fehler {0}"
	IDS_PURGE_ADMIN_REQUIRED, "Dieser Befehl erfordert eine erhöhte xucRun-Instanz.\n\nStarten Sie eine Konsole als Administrator und führen Sie den Befehl erneut aus."
	IDS_PURGE_CONFIRMATION, "Dieser Vorgang löscht unwiderruflich alle von xucRun gespeicherten Anmeldedaten, Freigaben, Sicherheitsmerkmale und Credential-Metadaten für alle Windows-Benutzerprofile dieses Computers.\n\nDer Dienst wird anschließend beendet.\n\nFortfahren?"
	IDS_PURGE_TITLE, "Alle xucRun-Daten löschen"
	IDS_PURGE_SCM_OPEN_FAILED, "Der Service Control Manager konnte nicht geöffnet werden. Fehler {0}"
	IDS_PURGE_SERVICE_OPEN_FAILED, "Der xucRun-Brokerdienst konnte nicht geöffnet werden. Fehler {0}"
	IDS_PURGE_SERVICE_START_FAILED, "Der xucRun-Brokerdienst konnte nicht gestartet werden. Fehler {0}"
	IDS_PURGE_SERVICE_START_TIMEOUT, "Der xucRun-Brokerdienst wurde nicht rechtzeitig gestartet. Fehler {0}"
	IDS_PURGE_SERVICE_INVALID_STATE, "Der xucRun-Brokerdienst befindet sich nicht in einem löschbaren Zustand."
	IDS_PURGE_REQUEST_REJECTED, "Die Löschanforderung wurde vom xucRun-Brokerdienst abgelehnt. Fehler {0}"
	IDS_PURGE_STOP_TIMEOUT, "Der xucRun-Brokerdienst wurde nach der Löschanforderung nicht rechtzeitig beendet. Fehler {0}"
	IDS_PURGE_INCOMPLETE, "Der Brokerstore konnte nicht vollständig gelöscht werden. Fehler {0}"
	IDS_PURGE_SUCCEEDED, "Alle xucRun-Daten wurden für alle Windows-Benutzerprofile dieses Computers gelöscht."
	IDS_HELP_TITLE, "Hilfe"
	IDS_HELP_HEADING, "xucRun - Anwendungen in anderem Benutzerkontext starten"
	IDS_HELP_USAGE, "Anwendungen starten:\n• {0} <Anwendung> [Argumente...]\n  Automatische Konto- und Rechteauswahl.\n• {0} [Benutzerschalter] <Anwendung> [Argumente...]\n  /user[:<Benutzername>] behält den aktuellen Rechtemodus bei.\n  /user-elevated[:<Benutzername>] verlangt erhöhte Rechte oder bricht ab.\n• {0} /hidden [Benutzerschalter] <Anwendung> [Argumente...]\n  Blendet nur die unmittelbar gestartete Anwendung aus.\n• {0} /hidden-monitor [Benutzerschalter] <Anwendung> [Argumente...]\n  Meldet zusätzlich einen Rückgabecode ungleich 0.\n\nAnmeldedaten verwalten:\n• {0} /addcred [<Benutzername>] - Anmeldedaten sicher speichern\n• {0} /deletecred [<Benutzername>] - Anmeldedaten löschen\n• {0} /showcred - gespeicherte Konten anzeigen\n\nFreigaben verwalten:\n• {0} /showapprovals - gespeicherte Freigaben anzeigen\n• {0} /resetapprovals[:<Benutzername>] - zurückzusetzende Freigaben auswählen\n\nBackups verwalten:\n• {0} /backup - Backupverwaltung öffnen\n• {0} /backup-create [<Beschreibung>] - Backup erstellen\n• {0} /backup-list - verfügbare Backups auflisten\n• {0} /backup-restore - Backup zur Wiederherstellung auswählen\n• {0} /backup-restore:<Backup-ID> - Backup direkt wiederherstellen\n• {0} /backup-delete-all - alle Backups löschen\n\nStatus und Diagnose:\n• {0} /admin-status - gespeicherte Daten aller Benutzer anzeigen\n• {0} /clear-all - alle xucRun-Daten löschen\n• {0} /audit - Sicherheitsdiagnose ausführen\n• {0} /help, {0} --help, {0} /? - diese Hilfe anzeigen\n• Aliase: --hidden, --hidden-monitor\n\n"
	IDS_HELP_EXAMPLES, "Beispiele:\n• Standardstart:\n  {0} notepad.exe\n• Anderes Konto mit unverändertem Rechtemodus:\n  {0} /user:Administrator notepad.exe\n• Garantiert erhöhter Start:\n  {0} /user-elevated:Administrator notepad.exe\n• Verborgener Start mit Überwachung des Rückgabecodes:\n  {0} /hidden-monitor cmd.exe /c task.cmd\n• Anmeldedaten speichern:\n  {0} /addcred DOMAIN\\AdminUser\n  Das Kennwort wird auf einem geschützten privaten Desktop abgefragt.\n\n"
	IDS_HELP_NOTES, "Wichtige Hinweise:\n• Anmeldedaten sind an die SID des angemeldeten Windows-Benutzers gebunden und werden im LocalSystem-Broker gespeichert.\n• Ohne Benutzerschalter werden Administratorkonten bevorzugt und erhöht gestartet. Ein passendes Konto wird automatisch gewählt; mehrere Konten werden zur Auswahl angeboten. Standardkonten werden nur verwendet, wenn kein Administratorkonto verfügbar ist.\n• Beim aktuellen Administratorkonto bleibt ein bereits erhöhter Zustand erhalten; andernfalls fordert xucRun automatisch Windows-UAC an.\n• /user lässt den Rechtemodus unverändert; ohne Benutzernamen wird ein gespeichertes Konto automatisch gewählt oder eine Auswahl angeboten.\n• /user-elevated garantiert erhöhte Rechte; ohne Benutzernamen werden nur gespeicherte Administratorkonten angeboten.\n• /hidden und /hidden-monitor betreffen nur die unmittelbar gestartete Anwendung. Ihre Dialoge und Kindprozesse bleiben sichtbar. /hidden-monitor wertet nur den Rückgabecode aus und erfasst keine Ausgabe.\n• /resetapprovals ohne Benutzernamen kann auch profilweite Freigaben zurücksetzen; ein gezielter Benutzeraufruf lässt sie unverändert.\n• Backups enthalten alle Brokerdaten, sind an diesen Computer gebunden und können nicht auf andere Computer übertragen werden.\n• /clear-all löscht unwiderruflich alle xucRun-Daten aller Windows-Profile dieses Computers und beendet den Brokerdienst.\n• /audit prüft laufenden Client, installierte Core-Dateien, Signaturen, Zertifikat, Broker-Richtlinie und -ACLs, Konfiguration und eine optionale Tray-Installation, ohne Anmeldedaten zu lesen.\n• Ein Benutzerschalter ohne Anwendung ersetzt die aktuelle Konsole im gewählten Modus."
	IDS_HELP_INFO, "Laufzeitinformationen:\n• {0} /info - Versionen, Signierzertifikat, Brokerstatus, Konto, Konfiguration und Anzahlen gespeicherter Daten anzeigen\n\n"
	IDS_INFO_TITLE, "Informationen"
	IDS_INFO_HEADING, "xucRun-Laufzeitinformationen"
	IDS_INFO_CONTENT, "Programm\nVersion: {0}\nPfad: {1}\nArchitektur: {2}\nSprache: {3}\n\nSignierzertifikat\nName: {4}\nSHA-256-Fingerabdruck: {5}\nGültig seit: {6}\nGültig bis: {7}\n\nBroker\nDienststatus: {8}\nKommunikation: {9}\nVersion: {10}\n\nAktuelles Konto\nKonto: {11}\nRechteerhöhung: {12}\n\nKonfiguration\nDatei: {13}\nClient-Protokollierung: {14}\nBroker-Informationsereignisse: {15}\n\nGespeicherte Daten\nAnmeldedaten: {16}\nFreigaben: {17}"
	IDS_INFO_LANGUAGE_GERMAN, "Deutsch"
